O1004
(PIN-001 STANDARD PROGRAM)
(X0Z0 - CENTERLINE AND FRONT FINISHED FACE)
(BAR PROJECTION FROM CHUCK FACE = PART LG + 5 MM)

#8  = SQRT[256]        (BASE 16)
#9  = #8*1.5           (24)
#10 = #9-1             (23)
#11 = #8*2.875         (46)
#12 = #10+#9           (47)
#13 = ABS[-3]          (3)
#14 = ROUND[1.6]       (2)

#1 = #8                (SMALL DIAMETER)
#2 = #9                (FRONT CHAMFER DIAMETER)
#3 = #10               (SMALL DIAMETER LENGTH)
#4 = #11               (LARGE DIAMETER)
#5 = #12               (TOTAL PART LENGTH)
#6 = #13               (INNER RADIUS)
#7 = #14               (OUTER RADIUS)


<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>SnippetsDialog</class>
    <widget class="QDialog" name="SnippetsDialog">
        <property name="windowTitle">
            <string>Snippets</string>
        </property>
        <property name="minimumSize">
            <size>
                <width>700</width>
                <height>430</height>
            </size>
        </property>
        <layout class="QVBoxLayout" name="verticalLayout">
            <item>
                <widget class="QSplitter" name="splitter">
                    <property name="orientation">
                        <enum>Qt::Orientation::Horizontal</enum>
                    </property>
                    <widget class="QListWidget" name="snippetList"/>
                    <widget class="ZoomableSnippetEditor" name="snippetEditor">
                        <property name="font">
                            <font>
                                <family>Courier New</family>
                                <pointsize>9</pointsize>
                            </font>
                        </property>
                        <property name="lineWrapMode">
                            <enum>QPlainTextEdit::LineWrapMode::WidgetWidth</enum>
                        </property>
                    </widget>
                </widget>
            </item>
            <item>
                <layout class="QHBoxLayout" name="buttonsLayout">
                    <item>
                        <widget class="QPushButton" name="upButton">
                            <property name="icon"><iconset resource="../../../resources/files_res.qrc"><normaloff>:/resource/icons/up.png</normaloff></iconset></property>
                            <property name="iconSize"><size><width>24</width><height>24</height></size></property>
                            <property name="toolTip"><string>Up</string></property>
                            <property name="accessibleName"><string>Up</string></property>
                        </widget>
                    </item>
                    <item>
                        <widget class="QPushButton" name="downButton">
                            <property name="icon"><iconset resource="../../../resources/files_res.qrc"><normaloff>:/resource/icons/down.png</normaloff></iconset></property>
                            <property name="iconSize"><size><width>24</width><height>24</height></size></property>
                            <property name="toolTip"><string>Down</string></property>
                            <property name="accessibleName"><string>Down</string></property>
                        </widget>
                    </item>
                    <item>
                        <widget class="QPushButton" name="addButton">
                            <property name="icon"><iconset resource="../../../resources/files_res.qrc"><normaloff>:/resource/icons/add.png</normaloff></iconset></property>
                            <property name="iconSize"><size><width>24</width><height>24</height></size></property>
                            <property name="toolTip"><string>Add</string></property>
                            <property name="accessibleName"><string>Add</string></property>
                        </widget>
                    </item>
                    <item>
                        <widget class="QPushButton" name="saveButton">
                            <property name="icon"><iconset resource="../../../resources/files_res.qrc"><normaloff>:/resource/icons/save.png</normaloff></iconset></property>
                            <property name="iconSize"><size><width>24</width><height>24</height></size></property>
                            <property name="toolTip"><string>Save</string></property>
                            <property name="accessibleName"><string>Save</string></property>
                        </widget>
                    </item>
                    <item>
                        <widget class="QPushButton" name="renameButton">
                            <property name="icon"><iconset resource="../../../resources/files_res.qrc"><normaloff>:/resource/icons/rename.png</normaloff></iconset></property>
                            <property name="iconSize"><size><width>24</width><height>24</height></size></property>
                            <property name="toolTip"><string>Rename</string></property>
                            <property name="accessibleName"><string>Rename</string></property>
                        </widget>
                    </item>
                    <item>
                        <widget class="QPushButton" name="deleteButton">
                            <property name="icon"><iconset resource="../../../resources/files_res.qrc"><normaloff>:/resource/icons/trash.png</normaloff></iconset></property>
                            <property name="iconSize"><size><width>24</width><height>24</height></size></property>
                            <property name="toolTip"><string>Delete</string></property>
                            <property name="accessibleName"><string>Delete</string></property>
                        </widget>
                    </item>
                    <item>
                        <spacer name="buttonSpacer">
                            <property name="orientation">
                                <enum>Qt::Orientation::Horizontal</enum>
                            </property>
                            <property name="sizeHint">
                                <size>
                                    <width>40</width>
                                    <height>20</height>
                                </size>
                            </property>
                        </spacer>
                    </item>
                    <item>
                        <widget class="QPushButton" name="insertButton">
                            <property name="text">
                                <string>Insert</string>
                            </property>
                        </widget>
                    </item>
                    <item>
                        <widget class="QPushButton" name="cancelButton">
                            <property name="text">
                                <string>Cancel</string>
                            </property>
                        </widget>
                    </item>
                </layout>
            </item>
        </layout>
    </widget>
    <customwidgets>
        <customwidget>
            <class>ZoomableSnippetEditor</class>
            <extends>QPlainTextEdit</extends>
            <header>app.ui.support.snippet_editor</header>
        </customwidget>
    </customwidgets>
    <resources><include location="../../../resources/files_res.qrc"/></resources>
